          "Donjon": {
            "type": "custom",
            "isShared": true,
            "isHidden": "no",
            "height": 22,
            "alignment": "CENTER",
            "displayedTitle": "Donjon",
            "defaultValue": {
              "etage": 0
            },
            "blueprint": {
              "type": "div",
              "props": {
                "style": {
                  "display": "flex",
                  "flexDirection": "column",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "gap": "8px",
                  "height": "100%",
                  "color": "white",
                  "textAlign": "center"
                }
              },
              "children": [
                {
                  "type": "div",
                  "props": {
                    "style": {
                      "fontSize": "1.05em",
                      "fontWeight": "bold"
                    }
                  },
                  "children": "{{ game.data.Donjon.etage >= 4 ? 'Boss !' : 'Étage ' + game.data.Donjon.etage + ' / 3' }}"
                },
                {
                  "type": "button",
                  "props": {
                    "className": "btn btn-primary btn-sm"
                  },
                  "onClick": "const salles=['Salle1','Salle2','Salle3','Salle4'];\nconst d=game.data.Donjon;\nif(d.etage>=4){functions.chatLog('Le combat contre le Boss est déjà lancé.');return;}\nconst restants=salles.flatMap(s=>cards[s]??[]);\nif(restants.length) await functions.moveCards(restants,'CimetiereMonstres');\nif(d.etage>=3){d.etage=4;functions.chatLog('Les 3 étages sont terminés : place au Boss ! (+2 énergie)');await functions.repositionCards();return;}\nfor(const s of salles){await functions.drawFromExtraDeck('Monstres',1,false,s);}\nd.etage=d.etage+1;\nfunctions.chatLog('Étage '+d.etage+' : 4 nouveaux monstres dans les salles (+2 énergie).');\nawait functions.repositionCards();",
                  "children": "Étage suivant"
                }
              ]
            },
            "events": {
              "onPlayersReady": "if(!game.isHost)return;\nawait functions.shuffleSection('Monstres');\nconst d=game.data.Donjon;\nfor(const s of ['Salle1','Salle2','Salle3','Salle4']){await functions.drawFromExtraDeck('Monstres',1,false,s);}\nd.etage=1;\nfunctions.chatLog('Étage 1 : 4 monstres dans les salles.');\nawait functions.repositionCards();",
              "onUpdate": "const e=game.data.Donjon.etage;\nif(e<=1){window.__grEtage=e;return;}\nconst prev=Math.max(window.__grEtage??1,1);\nif(e>prev){window.__grEtage=e;await functions.drawFromExtraDeck('PiocheEnergie',(e-prev)*2,false,'Energie');}"
            }
          }
