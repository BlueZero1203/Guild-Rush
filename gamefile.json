          "Donjon": {
            "type": "custom",
            "isShared": true,
            "isHidden": "no",
            "height": 14,
            "alignment": "CENTER",
            "displayedTitle": "Donjon",
            "defaultValue": {
              "etage": 0
            },
            "blueprint": {
              "type": "div",
              "props": {
                "style": {
                  "display": "flex",
                  "flexDirection": "column",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "gap": "8px",
                  "height": "200%",
                  "color": "white",
                  "textAlign": "center",
                  "position": "absolute",
                  "left": "calc(100% + 28px)",
                  "top": "0",
                  "width": "15vw",
                  "backgroundColor": "rgba(120,90,40,0.25)",
                  "border": "1px solid rgba(214,150,60,0.6)",
                  "borderRadius": "10px",
                  "zIndex": "5"
                }
              },
              "children": [
                {
                  "type": "div",
                  "props": {
                    "style": {
                      "fontSize": "1.05em",
                      "fontWeight": "bold"
                    }
                  },
                  "children": "{{ game.data.Donjon.etage >= 4 ? 'Boss !' : 'Étage ' + game.data.Donjon.etage + ' / 3' }}"
                },
                {
                  "type": "button",
                  "props": {
                    "className": "btn btn-warning"
                  },
                  "onClick": "const salles=['Salle1','Salle2','Salle3','Salle4'];\nconst d=game.data.Donjon;\nif(d.etage>=4){functions.chatLog('Le combat contre le Boss est déjà lancé.');return;}\nconst restants=salles.flatMap(s=>cards[s]??[]);\nif(restants.length) await functions.moveCards(restants,'CimetiereMonstres');\nif(d.etage>=3){d.etage=4;functions.chatLog('Les 3 étages sont terminés : place au Boss ! (+2 énergie)');{const e=game.data.Donjon?.etage??0;if(e<=1){globalThis.__grEtage=e;}else{const prev=Math.max(globalThis.__grEtage??1,1);if(e>prev){globalThis.__grEtage=e;await functions.drawFromExtraDeck('PiocheEnergie',(e-prev)*2,false,'Energie');}}}await functions.repositionCards();return;}\nfor(const s of salles){await functions.drawFromExtraDeck('Monstres',1,false,s);}\nd.etage=d.etage+1;\nfunctions.chatLog('Étage '+d.etage+' : 4 nouveaux monstres dans les salles (+2 énergie).');{const e=game.data.Donjon?.etage??0;if(e<=1){globalThis.__grEtage=e;}else{const prev=Math.max(globalThis.__grEtage??1,1);if(e>prev){globalThis.__grEtage=e;await functions.drawFromExtraDeck('PiocheEnergie',(e-prev)*2,false,'Energie');}}}\nawait functions.repositionCards();",
                  "children": "Étage suivant"
                },
                {
                  "type": "div",
                  "props": {
                    "data-gr": "res",
                    "style": {
                      "marginTop": "6px",
                      "fontSize": "0.85em",
                      "fontWeight": "bold",
                      "opacity": "0.8"
                    }
                  },
                  "children": "Ta Réserve"
                },
                {
                  "type": "button",
                  "props": {
                    "className": "btn btn-sm btn-outline-light",
                    "style": {
                      "width": "85%"
                    },
                    "data-gr": "res"
                  },
                  "onClick": "const n=(cards.Reserve??[]).length;\nif(!n){functions.chatLog('Réserve vide.');return;}\nawait functions.drawFromExtraDeck('Reserve',Math.min(1,n),false,'Hand');\nfunctions.chatLog('pioche '+Math.min(1,n)+' carte(s) de sa Réserve.');\nawait functions.repositionCards();",
                  "children": "Piocher 1"
                },
                {
                  "type": "button",
                  "props": {
                    "className": "btn btn-sm btn-outline-light",
                    "style": {
                      "width": "85%"
                    },
                    "data-gr": "res"
                  },
                  "onClick": "const n=(cards.Reserve??[]).length;\nif(!n){functions.chatLog('Réserve vide.');return;}\nawait functions.drawFromExtraDeck('Reserve',Math.min(3,n),false,'Hand');\nfunctions.chatLog('pioche '+Math.min(3,n)+' carte(s) de sa Réserve.');\nawait functions.repositionCards();",
                  "children": "Piocher 3 (Cueillette)"
                },
                {
                  "type": "button",
                  "props": {
                    "className": "btn btn-sm btn-outline-light",
                    "style": {
                      "width": "85%"
                    },
                    "data-gr": "res"
                  },
                  "onClick": "if(!(cards.Reserve??[]).length){functions.chatLog('Réserve vide.');return;}\nawait functions.shuffleSection('Reserve');\nfunctions.chatLog('mélange sa Réserve.');",
                  "children": "Mélanger"
                }
              ]
            },
            "events": {
              "onPlayersReady": "if(!game.isHost)return;\nawait functions.shuffleSection('Monstres');\nconst d=game.data.Donjon;\nfor(const s of ['Salle1','Salle2','Salle3','Salle4']){await functions.drawFromExtraDeck('Monstres',1,false,s);}\nd.etage=1;\nfunctions.chatLog('Étage 1 : 4 monstres dans les salles.');\nawait functions.repositionCards();",
              "onUpdate": "{const e=game.data.Donjon?.etage??0;if(e<=1){globalThis.__grEtage=e;}else{const prev=Math.max(globalThis.__grEtage??1,1);if(e>prev){globalThis.__grEtage=e;await functions.drawFromExtraDeck('PiocheEnergie',(e-prev)*2,false,'Energie');}}}",
              "onCardsUpdate": "{const e=game.data.Donjon?.etage??0;if(e<=1){globalThis.__grEtage=e;}else{const prev=Math.max(globalThis.__grEtage??1,1);if(e>prev){globalThis.__grEtage=e;await functions.drawFromExtraDeck('PiocheEnergie',(e-prev)*2,false,'Energie');}}}",
              "onNewTurn": "{const e=game.data.Donjon?.etage??0;if(e<=1){globalThis.__grEtage=e;}else{const prev=Math.max(globalThis.__grEtage??1,1);if(e>prev){globalThis.__grEtage=e;await functions.drawFromExtraDeck('PiocheEnergie',(e-prev)*2,false,'Energie');}}}{if(game.turn?.isMyTurn){const t=(cards.Energie??[]).filter(c=>c.isTapped);if(t.length){await functions.updateCards([t[0]],{isTapped:false});functions.chatLog('Aube : 1 énergie redressée.');}}}"
            }
